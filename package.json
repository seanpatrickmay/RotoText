{
  "name": "rototext",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run fetch-assets",
    "predev:lan": "npm run fetch-assets",
    "prebuild": "npm run fetch-assets",
    "dev": "vite",
    "dev:lan": "vite --host --mode lan",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --mode lan",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-assets": "node scripts/fetch-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
